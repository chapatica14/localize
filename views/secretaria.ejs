<%- include('partials/header') %>
<h1>Painel da Secretaria da Universidade Técnica</h1>

<section class="cartao">
  <h2>1. Fila de Entrada · Pendente de Entrega (<%= fila.length %>)</h2>
  <p style="color: var(--suave); font-size: 0.9rem; margin-top: -0.5rem; margin-bottom: 1rem;">
    Itens registados como achados que aguardam entrega física pelo utilizador na Secretaria.
  </p>
  <% if (fila.length > 0) { %>
    <% fila.forEach(function(a) { %>
      <form method="post" action="/secretaria/receber/<%= a.id %><%= token ? '?token=' + token : '' %>" class="linha">
        <span>
          <strong><%= a.codigo %></strong> · <%= a.categoria %> · <%= a.marca || 'sem marca' %> · <%= a.cor || 'sem cor' %> · <%= a.local_campus %>
          <br><small><span class="badge badge--pendente_entrega">Pendente de Entrega na Secretaria</span></small>
        </span>
        <input name="localizacao" placeholder="Ex.: Armário A - Gaveta 2" required>
        <button class="btn btn--sec">Receber na Secretaria</button>
      </form>
    <% }); %>
  <% } else { %>
    <p class="nota">Nenhum item à espera de entrega física no momento.</p>
  <% } %>
</section>

<section class="cartao">
  <h2>2. Cruzamento de Dados e Correspondências (Match)</h2>
  <p style="color: var(--suave); font-size: 0.9rem; margin-top: -0.5rem; margin-bottom: 1rem;">
    Itens em custódia na Secretaria cruzados com as notificações de perda ativas. Ao confirmar, o proprietário recebe notificação imediata.
  </p>
  <% if (custodia.length > 0) { %>
    <% custodia.forEach(function(item) { var a = item.achado; var cands = item.cands; %>
      <div class="match">
        <p><strong>Achado <%= a.codigo %></strong> · <%= a.categoria %> · <%= a.marca || 'sem marca' %> · <%= a.cor || 'sem cor' %> · <%= a.local_campus %>
          <br><small><strong>Local de guarda:</strong> <%= a.localizacao %></small>
          <br><span class="badge badge--em_custodia">Em custódia na Secretaria</span>
        </p>
        <% if (cands.length > 0) { %>
          <% cands.forEach(function(c) { %>
            <form method="post" action="/secretaria/match<%= token ? '?token=' + token : '' %>" class="linha" style="background: #fafbf9; padding: 0.75rem; border-radius: var(--raio); margin-top: 0.5rem;">
              <input type="hidden" name="achado" value="<%= a.id %>">
              <input type="hidden" name="perdido" value="<%= c.id %>">
              <span>
                <strong>Perdido <%= c.codigo %></strong> · <%= c.categoria %> · <%= c.marca || 'sem marca' %> · <%= c.cor || 'sem cor' %> · <%= c.local_campus %>
                <br><span class="badge badge--aguardando_localizacao">Aguardando Localização / Em Espera</span>
              </span>
              <meter min="0" max="100" low="50" high="75" optimum="100" value="<%= c.score %>"></meter>
              <strong><%= c.score %>% de afinidade</strong>
              <button class="btn btn--sec">Confirmar Match & Notificar</button>
            </form>
          <% }); %>
        <% } else { %>
          <p class="nota">Sem notificações de perda com dados similares no momento.</p>
        <% } %>
      </div>
    <% }); %>
  <% } else { %>
    <p class="nota">Nenhum item em custódia na Secretaria à espera de cruzamento.</p>
  <% } %>
</section>

<section class="cartao">
  <h2>3. Disponível para Levantamento na Secretaria (<%= retirada.length %>)</h2>
  <p style="color: var(--suave); font-size: 0.9rem; margin-top: -0.5rem; margin-bottom: 1rem;">
    Itens com correspondência confirmada aguardando o comparecimento do proprietário com documento de identificação.
  </p>
  <% if (retirada.length > 0) { %>
    <% retirada.forEach(function(r) { %>
      <form method="post" action="/secretaria/devolver/<%= r.id %><%= token ? '?token=' + token : '' %>" class="linha">
        <span>
          <strong><%= r.codigo %></strong> (Ref: <%= r.cod_perdido %>) · <%= r.categoria %>
          <br><small><strong>Local no depósito:</strong> <%= r.localizacao %> | <strong>Proprietário:</strong> <%= r.dono %></small>
          <br><span class="badge badge--disponivel_levantamento">Disponível para Levantamento</span>
        </span>
        <input name="documento" placeholder="Nº do BI ou Matrícula do aluno" required>
        <button class="btn btn--primario">Registar Devolução</button>
      </form>
    <% }); %>
  <% } else { %>
    <p class="nota">Nenhum item aguardando retirada no momento.</p>
  <% } %>
</section>
<%- include('partials/footer') %>
